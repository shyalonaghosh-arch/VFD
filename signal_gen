#include "driver/mcpwm_prelude.h"
#include "esp_attr.h"
#include "esp_err.h"
#include <math.h>

// ============================================================
// PIN ASSIGNMENTS
// ============================================================

#define PWM_A_HIN 25
#define PWM_A_LIN 26

#define PWM_B_HIN 14
#define PWM_B_LIN 15

#define PWM_C_HIN 32
#define PWM_C_LIN 33

// ============================================================
// PWM SETTINGS
// ============================================================

#define CARRIER_FREQ       16000UL      // 16 kHz
#define TIMER_RESOLUTION   10000000UL   // 10 MHz -> 0.1 us per tick
#define PWM_PERIOD         (TIMER_RESOLUTION / CARRIER_FREQ)   // 625 ticks

#define DEAD_TIME_US       1
#define DEAD_TIME_TICKS    ((TIMER_RESOLUTION / 1000000UL) * DEAD_TIME_US)  // 10 ticks

// ============================================================
// OUTPUT SETTINGS
// ============================================================

#define SINE_FREQ_HZ       5.0       // electrical output frequency
#define AMPLITUDE          0.43      // 0.0 - 0.5 (fraction of the period, around 50% center)

// Keep AMPLITUDE <= ~0.45 so minimum on-time stays longer than dead time
// (0.05 * 625 = 31 ticks > 10 dead-time ticks)

// ============================================================
// SINE LOOKUP (compare values in timer ticks)
// ============================================================

#define TABLE_SIZE 256
static uint16_t compareTable[TABLE_SIZE];

// ============================================================
// PHASE ACCUMULATOR
// 32-bit: top 8 bits select the table entry
// ============================================================

static volatile uint32_t phaseAcc = 0;
static uint32_t phaseInc = 0;

#define PHASE_120 0x55555555UL   // 2^32 / 3
#define PHASE_240 0xAAAAAAAAUL   // 2 * 2^32 / 3

// ============================================================
// MCPWM HANDLES
// ============================================================

static mcpwm_timer_handle_t timer = NULL;

static mcpwm_oper_handle_t operA = NULL;
static mcpwm_oper_handle_t operB = NULL;
static mcpwm_oper_handle_t operC = NULL;

static mcpwm_cmpr_handle_t cmprA = NULL;
static mcpwm_cmpr_handle_t cmprB = NULL;
static mcpwm_cmpr_handle_t cmprC = NULL;

static mcpwm_gen_handle_t genAH = NULL;
static mcpwm_gen_handle_t genAL = NULL;
static mcpwm_gen_handle_t genBH = NULL;
static mcpwm_gen_handle_t genBL = NULL;
static mcpwm_gen_handle_t genCH = NULL;
static mcpwm_gen_handle_t genCL = NULL;

// ============================================================
// BUILD SINE TABLE
// ============================================================

void buildSineTable() {
    for (int i = 0; i < TABLE_SIZE; i++) {
        double duty = 0.5 + AMPLITUDE * sin(2.0 * M_PI * i / TABLE_SIZE);
        int32_t ticks = (int32_t)(duty * PWM_PERIOD + 0.5);

        if (ticks < 1) ticks = 1;
        if (ticks > (int32_t)PWM_PERIOD - 1) ticks = PWM_PERIOD - 1;

        compareTable[i] = (uint16_t)ticks;
    }
}

// ============================================================
// SET OUTPUT FREQUENCY
// ============================================================

void setFrequency(double hz) {
    // phase step per PWM period
    phaseInc = (uint32_t)(hz * 4294967296.0 / (double)CARRIER_FREQ);
}

// ============================================================
// TIMER ISR: runs once per PWM period (at timer peak)
// Comparator values latch at the next TEZ, so no mid-cycle glitch.
// ============================================================

static bool IRAM_ATTR onTimerFull(
    mcpwm_timer_handle_t t,
    const mcpwm_timer_event_data_t *edata,
    void *user_ctx
) {
    uint32_t acc = phaseAcc + phaseInc;
    phaseAcc = acc;

    uint32_t idxA = acc >> 24;
    uint32_t idxB = (acc + PHASE_120) >> 24;
    uint32_t idxC = (acc + PHASE_240) >> 24;

    mcpwm_comparator_set_compare_value(cmprA, compareTable[idxA]);
    mcpwm_comparator_set_compare_value(cmprB, compareTable[idxB]);
    mcpwm_comparator_set_compare_value(cmprC, compareTable[idxC]);

    return false;   // no task wake-up needed
}

// ============================================================
// CONFIGURE ONE HALF-BRIDGE (HIGH + LOW with dead time)
// ============================================================

void configurePhase(
    mcpwm_oper_handle_t oper,
    mcpwm_cmpr_handle_t cmpr,
    int highPin,
    int lowPin,
    mcpwm_gen_handle_t *genHigh,
    mcpwm_gen_handle_t *genLow
) {
    // Generators
    mcpwm_generator_config_t genHighConfig = {};
    genHighConfig.gen_gpio_num = highPin;
    ESP_ERROR_CHECK(mcpwm_new_generator(oper, &genHighConfig, genHigh));

    mcpwm_generator_config_t genLowConfig = {};
    genLowConfig.gen_gpio_num = lowPin;
    ESP_ERROR_CHECK(mcpwm_new_generator(oper, &genLowConfig, genLow));

    // PWM waveform on the HIGH-side generator only:
    // timer empty -> HIGH, compare match -> LOW
    ESP_ERROR_CHECK(mcpwm_generator_set_action_on_timer_event(
        *genHigh,
        MCPWM_GEN_TIMER_EVENT_ACTION(
            MCPWM_TIMER_DIRECTION_UP,
            MCPWM_TIMER_EVENT_EMPTY,
            MCPWM_GEN_ACTION_HIGH)));

    ESP_ERROR_CHECK(mcpwm_generator_set_action_on_compare_event(
        *genHigh,
        MCPWM_GEN_COMPARE_EVENT_ACTION(
            MCPWM_TIMER_DIRECTION_UP,
            cmpr,
            MCPWM_GEN_ACTION_LOW)));

    // Dead time
    // High side: delay rising edge
    mcpwm_dead_time_config_t dtHigh = {};
    dtHigh.posedge_delay_ticks = DEAD_TIME_TICKS;
    dtHigh.negedge_delay_ticks = 0;
    ESP_ERROR_CHECK(mcpwm_generator_set_dead_time(*genHigh, *genHigh, &dtHigh));

    // Low side: takes the high-side signal, inverts it, delays its rising edge
    mcpwm_dead_time_config_t dtLow = {};
    dtLow.posedge_delay_ticks = 0;
    dtLow.negedge_delay_ticks = DEAD_TIME_TICKS;
    dtLow.flags.invert_output = true;
    ESP_ERROR_CHECK(mcpwm_generator_set_dead_time(*genHigh, *genLow, &dtLow));
}

// ============================================================
// SETUP
// ============================================================

void setup() {
    Serial.begin(115200);
    delay(500);

    Serial.println();
    Serial.println("3-Phase MCPWM Starting...");
    Serial.printf("Carrier: %lu Hz\n", CARRIER_FREQ);
    Serial.printf("Period ticks: %lu\n", PWM_PERIOD);
    Serial.printf("Dead time: %d us (%lu ticks)\n", DEAD_TIME_US, DEAD_TIME_TICKS);
    Serial.printf("Output frequency: %.2f Hz\n", SINE_FREQ_HZ);

    buildSineTable();
    setFrequency(SINE_FREQ_HZ);

    // Timer
    mcpwm_timer_config_t timerConfig = {};
    timerConfig.group_id      = 0;
    timerConfig.clk_src       = MCPWM_TIMER_CLK_SRC_DEFAULT;
    timerConfig.resolution_hz = TIMER_RESOLUTION;
    timerConfig.count_mode    = MCPWM_TIMER_COUNT_MODE_UP;
    timerConfig.period_ticks  = PWM_PERIOD;
    ESP_ERROR_CHECK(mcpwm_new_timer(&timerConfig, &timer));

    // Operators
    mcpwm_operator_config_t operatorConfig = {};
    operatorConfig.group_id = 0;
    ESP_ERROR_CHECK(mcpwm_new_operator(&operatorConfig, &operA));
    ESP_ERROR_CHECK(mcpwm_new_operator(&operatorConfig, &operB));
    ESP_ERROR_CHECK(mcpwm_new_operator(&operatorConfig, &operC));

    ESP_ERROR_CHECK(mcpwm_operator_connect_timer(operA, timer));
    ESP_ERROR_CHECK(mcpwm_operator_connect_timer(operB, timer));
    ESP_ERROR_CHECK(mcpwm_operator_connect_timer(operC, timer));

    // Comparators (value latched at timer-empty)
    mcpwm_comparator_config_t cmpConfig = {};
    cmpConfig.flags.update_cmp_on_tez = true;
    ESP_ERROR_CHECK(mcpwm_new_comparator(operA, &cmpConfig, &cmprA));
    ESP_ERROR_CHECK(mcpwm_new_comparator(operB, &cmpConfig, &cmprB));
    ESP_ERROR_CHECK(mcpwm_new_comparator(operC, &cmpConfig, &cmprC));

    // Half-bridges
    configurePhase(operA, cmprA, PWM_A_HIN, PWM_A_LIN, &genAH, &genAL);
    configurePhase(operB, cmprB, PWM_B_HIN, PWM_B_LIN, &genBH, &genBL);
    configurePhase(operC, cmprC, PWM_C_HIN, PWM_C_LIN, &genCH, &genCL);

    // Initial duty (50% on all phases until the ISR takes over)
    ESP_ERROR_CHECK(mcpwm_comparator_set_compare_value(cmprA, compareTable[0]));
    ESP_ERROR_CHECK(mcpwm_comparator_set_compare_value(cmprB, compareTable[85]));
    ESP_ERROR_CHECK(mcpwm_comparator_set_compare_value(cmprC, compareTable[171]));

    // Register the per-period ISR (must be done before enabling the timer)
    mcpwm_timer_event_callbacks_t cbs = {};
    cbs.on_full = onTimerFull;
    ESP_ERROR_CHECK(mcpwm_timer_register_event_callbacks(timer, &cbs, NULL));

    // Start
    ESP_ERROR_CHECK(mcpwm_timer_enable(timer));
    ESP_ERROR_CHECK(mcpwm_timer_start_stop(timer, MCPWM_TIMER_START_NO_STOP));

    Serial.println("MCPWM running.");
}

// ============================================================
// LOOP
// Nothing to do: the ISR handles all waveform updates.
// Call setFrequency(x) here if you want to change frequency at runtime.
// ============================================================

void loop() {
    delay(1000);
}
